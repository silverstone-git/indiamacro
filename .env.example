# Copy to .env and fill in. .env is gitignored.
# Any OpenAI-compatible /chat/completions server with function calling.
LLM_ENDPOINT=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# OPENAI_BASE_URL / OPENAI_API_KEY / OPENAI_MODEL are accepted instead of the three above.

# 1 = simulated data for every live feed (offline demos). Shown as SIM on screen.
# INDIAMACRO_DEMO=1

# Public deploy (./deploy.sh): HTTP basic auth for https://t.aryan.cfd/indiamacro/.
# deploy.sh writes /etc/nginx/.htpasswd-indiamacro (bcrypt) from these two.
INDIAMACRO_USERNAME=
INDIAMACRO_KEY=
